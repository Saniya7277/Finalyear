# TEMPLATE ONLY - this file IS committed. Put real values in .env, never here.
#
# Copy it:  cp .env.example .env    (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# Supabase Postgres (required)
#
# Metadata only: users, teammates, invitations, file rows, share rows.
# No file content is ever written here.
#
# USE THE SESSION POOLER STRING, NOT THE DIRECT ONE.
#   Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The direct host, db.<project-ref>.supabase.co, resolves to IPv6 only. Any host
# without an IPv6 route - Replit, most CI, many campus and office networks -
# fails with ENOTFOUND or ENETUNREACH, intermittently if IPv6 comes and goes.
# The pooler has IPv4 and works everywhere. Note the username differs: it is
# `postgres.<project-ref>`, not plain `postgres`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Storage (required to share files)
#
# Holds the encrypted blobs and nothing else. The bucket MUST be private:
#   Dashboard -> Storage -> New bucket -> name "secure-files", Public = OFF.
#
# SUPABASE_SERVICE_ROLE_KEY is a server-side secret. It must never appear in an
# EXPO_PUBLIC_* variable, in the mobile app, or in the client bundle - anyone
# holding it can read the whole bucket. The app never talks to Storage directly;
# it goes through the API, which is where authorisation and decryption happen.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=secure-files

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=5000

# Clerk BACKEND key, used to verify session tokens on every request.
# This is the "Secret key" from Clerk -> API Keys, and it starts with sk_.
# The pk_ value is the publishable key and belongs in EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY
# instead - putting a pk_ here makes every authenticated request fail.
CLERK_SECRET_KEY=sk_test_...

# Where invitation links point (the Expo app's origin).
FRONTEND_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# File encryption (required before any file can be shared)
#
# AES-256-GCM key: exactly 64 hex characters. Generate one with:
#   openssl rand -hex 32
#
# This is the single secret that keeps Supabase from being able to read your
# users' files. It lives ONLY in this API server's environment: it is never
# written to the database, never sent to Supabase Storage, never logged, and
# never shipped to the mobile app.
#
# Do not store it in Supabase (not in a table, not in Vault, not in Edge
# Function secrets) - keeping the key in the same system as the ciphertext
# defeats the point. Losing it means losing every file already stored.
# ---------------------------------------------------------------------------
FILE_ENCRYPTION_KEY=



# ---------------------------------------------------------------------------
# Email delivery for teammate invitations (optional)
#
# Without these, invitations are still created and the link is returned for
# manual sharing - only the email is skipped.
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>,
# SMTP_PASS=<16-character app password, not the account password>.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SecureSphere <no-reply@securesphere.app>"

# ---------------------------------------------------------------------------
# Expo app
#
# The app's variables do NOT go in this file. Expo reads .env from its own
# project directory, so they live in:
#
#     artifacts/securesphere/.env   (see the .env.example next to it)
#
# Keeping them separate is the point: everything Expo reads is bundled into the
# client, and nothing in this root file should ever end up there.
# ---------------------------------------------------------------------------
